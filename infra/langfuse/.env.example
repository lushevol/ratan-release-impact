# Copy to .env and replace every CHANGEME value before starting the stack.
NEXTAUTH_URL=http://localhost:3000
SALT=CHANGEME_random_hex
ENCRYPTION_KEY=CHANGEME_64_character_hex
NEXTAUTH_SECRET=CHANGEME_random_hex
TELEMETRY_ENABLED=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_random_hex
POSTGRES_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_random_hex
REDIS_AUTH=CHANGEME_random_hex
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_random_hex

LANGFUSE_INIT_ORG_ID=ratan-local
LANGFUSE_INIT_ORG_NAME=Ratan Local
LANGFUSE_INIT_PROJECT_ID=ratan-release-impact
LANGFUSE_INIT_PROJECT_NAME=Ratan Release Impact
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@local.langfuse
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_random_hex
