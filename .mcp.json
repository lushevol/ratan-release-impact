{
  "mcpServers": {
    "llm-wiki": {
      "command": ".venv/bin/python",
      "args": [
        ".claude/tools/mcp_trace_proxy.py",
        "--server",
        "llm-wiki",
        "--",
        "node",
        "/Applications/LLM Wiki.app/Contents/Resources/mcp-server/dist/src/index.js"
      ],
      "env": {
        "LLM_WIKI_API_TOKEN": "dummy"
      }
    },
    "sdlcGraph": {
      "command": ".venv/bin/python",
      "args": [
        ".claude/tools/mcp_trace_proxy.py",
        "--server",
        "sdlcGraph",
        "--",
        ".venv/bin/python",
        ".claude/skills/sdlc-graph/tools/sdlc_graph_mcp.py",
        "--data-dir",
        "sdlc-graph-output",
        "--config",
        "sdlc-graph-config.json"
      ]
    },
    "gitnexusRepos": {
      "command": ".venv/bin/python",
      "args": [
        ".claude/tools/mcp_trace_proxy.py",
        "--server",
        "gitnexusRepos",
        "--",
        ".venv/bin/python",
        ".claude/tools/gitnexus-repos-mcp.py",
        "--root",
        "."
      ]
    }
  }
}
