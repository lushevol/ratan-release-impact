{
  "mcpServers": {
    "openkb": {
      "command": ".venv/bin/python",
      "args": [
        ".claude/tools/mcp_trace_proxy.py",
        "--server",
        "openkb",
        "--",
        ".venv/bin/python",
        ".claude/tools/openkb-mcp.py",
        "--kb-dir",
        "knowledge-base"
      ]
    },
    "sdlcGraph": {
      "command": ".venv/bin/python",
      "args": [
        ".claude/tools/mcp_trace_proxy.py",
        "--server",
        "sdlcGraph",
        "--",
        ".venv/bin/python",
        ".claude/skills/sdlc-graph/tools/sdlc_graph_mcp.py",
        "--data-dir",
        "sdlc-graph-output",
        "--config",
        "sdlc-graph-config.json"
      ]
    },
    "gitnexusRepos": {
      "command": ".venv/bin/python",
      "args": [
        ".claude/tools/mcp_trace_proxy.py",
        "--server",
        "gitnexusRepos",
        "--",
        ".venv/bin/python",
        ".claude/tools/gitnexus-repos-mcp.py",
        "--root",
        "."
      ]
    }
  }
}
